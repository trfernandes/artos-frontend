## Componentes - Padrões de Uso

### 1. Telas de Listagem

**SEMPRE usar esta estrutura:**

```tsx
import { FancyBaseListPage } from '@/components/pages/FancyBaseListPage';
import { FancyCard } from '@/components/cards/FancyCard';
import { FancyExpandableFab } from '@/components/buttons/FancyExpandableFab';

export default function MinisteriosScreen() {
  return (
    <FancyBaseListPage
      title="Ministérios"
      showSearch={true}
      showNotifications={true}
      onSearch={handleSearch}
    >
      <FlatList
        data={ministerios}
        contentContainerStyle={{ gap: 12, padding: 16 }}
        renderItem={({ item }) => (
          <FancyCard
            icon="church"
            iconBackground={colors.primary}
            title={item.nome}
            subtitle={`Tipo: ${item.tipo}`}
            badge={item.status === 'ATIVO' ? 'Ativo' : 'Inativo'}
            badgeColor={item.status === 'ATIVO' ? '#E3F2FF' : '#F3F4F6'}
            onEdit={() => navigate(`/ministerios/${item.id}/editar`)}
            onOptions={() => showOptions(item)}
          />
        )}
      />
      
      <FancyExpandableFab
        onPress={() => navigate('/ministerios/novo')}
      />
    </FancyBaseListPage>
  );
}
```

**REGRAS:**
- SEMPRE usar `FancyBaseListPage` como container
- Gap entre cards: 12px
- Padding do container: 16px
- FAB no canto inferior direito
- Search bar no topo quando necessário

### 2. Formulários (Create/Edit)

**SEMPRE usar esta estrutura:**

```tsx
import { FancyBasePage } from '@/components/pages/FancyBasePage';
import { ControlledTextInput } from '@/components/forms/ControlledTextInput';
import { ControlledDropDown } from '@/components/forms/ControlledDropDown';
import { FancyButton } from '@/components/buttons/FancyButton';
import { useForm } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';

const schema = z.object({
  nome: z.string().min(1, 'Nome é obrigatório'),
  tipo: z.enum(['LOUVOR', 'MIDIA', 'INFANTIL', 'INTERCESSAO', 'OUTROS']),
  descricao: z.string().optional(),
});

type FormData = z.infer<typeof schema>;

export default function NovoMinisterioScreen() {
  const { control, handleSubmit } = useForm<FormData>({
    resolver: zodResolver(schema),
  });
  
  return (
    <FancyBasePage title="Novo Ministério" showBack>
      <ScrollView 
        contentContainerStyle={{ 
          padding: 16, 
          gap: 16  // Gap entre campos
        }}
      >
        <ControlledTextInput
          control={control}
          name="nome"
          label="Nome"
          placeholder="Digite o nome do ministério"
        />
        
        <ControlledDropDown
          control={control}
          name="tipo"
          label="Tipo"
          placeholder="Selecione..."
          items={[
            { label: 'Louvor', value: 'LOUVOR' },
            { label: 'Mídia', value: 'MIDIA' },
            // ...
          ]}
        />
        
        <ControlledTextInput
          control={control}
          name="descricao"
          label="Descrição"
          placeholder="Descrição opcional"
          multiline
          numberOfLines={4}
        />
      </ScrollView>
      
      <FancyButton
        title="Salvar"
        onPress={handleSubmit(onSubmit)}
        style={{ margin: 16 }}
      />
    </FancyBasePage>
  );
}
```

**REGRAS:**
- SEMPRE usar componentes `Controlled*` com React Hook Form
- SEMPRE validar com Zod
- Gap entre campos: 16px
- Padding do ScrollView: 16px
- Botão fixo no bottom com margin: 16px
- Labels em português, placeholders descritivos

### 3. Formulários Multi-Step (Wizard)

**SEMPRE usar esta estrutura:**

```tsx
import { FancyBasePage } from '@/components/pages/FancyBasePage';
import { FancyButton } from '@/components/buttons/FancyButton';

export default function NovoMinisterioWizard() {
  const [step, setStep] = useState(1);
  const totalSteps = 2;
  
  return (
    <FancyBasePage title="Novo Ministério" showBack>
      {/* Stepper */}
      <View style={{ flexDirection: 'row', padding: 16, alignItems: 'center' }}>
        {Array.from({ length: totalSteps }).map((_, i) => (
          <React.Fragment key={i}>
            <View
              style={{
                width: 40,
                height: 40,
                borderRadius: 20,
                backgroundColor: i + 1 <= step ? colors.primary : '#E5E7EB',
                justifyContent: 'center',
                alignItems: 'center',
              }}
            >
              <Text style={{ 
                color: i + 1 <= step ? 'white' : '#9CA3AF',
                fontWeight: '600' 
              }}>
                {i + 1}
              </Text>
            </View>
            
            <Text style={{ 
              fontSize: 14, 
              color: i + 1 <= step ? colors.primary : '#9CA3AF',
              marginLeft: 8,
              marginRight: i < totalSteps - 1 ? 8 : 0,
            }}>
              {i === 0 ? 'Dados' : 'Liderança'}
            </Text>
            
            {i < totalSteps - 1 && (
              <View style={{
                flex: 1,
                height: 2,
                backgroundColor: i + 1 < step ? colors.primary : '#E5E7EB',
                marginHorizontal: 8,
              }} />
            )}
          </React.Fragment>
        ))}
      </View>
      
      {/* Content baseado no step */}
      <ScrollView contentContainerStyle={{ padding: 16, gap: 16 }}>
        {step === 1 && <Step1Content />}
        {step === 2 && <Step2Content />}
      </ScrollView>
      
      {/* Botões de navegação */}
      <View style={{ 
        flexDirection: 'row', 
        gap: 12, 
        padding: 16 
      }}>
        {step > 1 && (
          <FancyButton
            title="Anterior"
            variant="secondary"
            onPress={() => setStep(step - 1)}
            style={{ flex: 1 }}
          />
        )}
        
        <FancyButton
          title={step === totalSteps ? 'Salvar' : 'Próximo'}
          onPress={step === totalSteps ? handleSave : () => setStep(step + 1)}
          style={{ flex: 1 }}
        />
      </View>
    </FancyBasePage>
  );
}
```

**REGRAS:**
- Stepper no topo com linha conectora
- Step ativo: azul primário
- Steps futuros: cinza claro
- Botões "Anterior" e "Próximo" no bottom
- Botão "Anterior" apenas se step > 1

### 4. Cards com Informações

**Padrão para listagem de itens:**

```tsx
<FancyCard
  icon="church"                    // Ícone da biblioteca @expo/vector-icons
  iconBackground={colors.primary}  // Cor de fundo do círculo do ícone
  title="Louvor"                   // Título principal
  subtitle="Tipo: Louvor"          // Subtítulo
  badge="Ativo"                    // Badge opcional
  badgeColor="#E3F2FF"            // Cor de fundo do badge
  onEdit={() => {}}                // Botão de editar (azul)
  onOptions={() => {}}             // Botão de opções (roxo, 3 pontinhos)
/>
```

**REGRAS:**
- Ícone sempre dentro de círculo colorido
- Badge com texto de status
- Dois botões de ação: editar (azul) e opções (roxo)
- Background do card: #F5F6FA

