{
  "permissions": {
    "allow": [
      "Bash(cd:*)",
      "Bash(npx tsc:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(while read file)",
      "Bash(do if grep -q \"TextInput\\\\|FancyText\" \"$file\")",
      "Bash(then echo \"$file\")",
      "Bash(fi)",
      "Bash(done)",
      "Bash(wc:*)",
      "mcp__mcp-registry__search_mcp_registry"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "expo"
  ]
}
