import { Pressable, StyleSheet, View } from 'react-native';
import FancyCardIcon from '../../cards/Horizontal/FancyCardIcon';
import FancyText from '../../FancyText';
import { DefaultIconsNames } from '../../../constants/icons';
import { ResponseNotificacaoDto } from '../../../domain/dtos/Notificacao/notificacao.response';
import { NotificacaoTipoEnum } from '../../../domain/enums/Notificacao/tipo-notificacao.enum';
import { CustomIconProps } from '../../FancyIcons';
import DateUtils from '../../../utils/date_utils';
import { usePallete } from '../../../hooks/usePallete';

const NOTIFICACAO_ICONS: Partial<Record<NotificacaoTipoEnum, CustomIconProps>> = {
  [NotificacaoTipoEnum.EscalaPublicada]: { library: 'MaterialCommunityIcons', name: 'calendar-check', size: 14 },
  [NotificacaoTipoEnum.EscalaAlterada]: { library: 'MaterialCommunityIcons', name: 'calendar-edit', size: 14 },
  [NotificacaoTipoEnum.EscalaCancelada]: { library: 'MaterialCommunityIcons', name: 'calendar-remove', size: 14 },
  [NotificacaoTipoEnum.EscalaConfirmacaoPendente]: { library: 'MaterialCommunityIcons', name: 'calendar-clock', size: 14 },
  [NotificacaoTipoEnum.EscalaSubstituicaoSolicitada]: { library: 'MaterialCommunityIcons', name: 'account-switch', size: 14 },
  [NotificacaoTipoEnum.EscalaSubstituicaoAceita]: { library: 'MaterialCommunityIcons', name: 'account-check', size: 14 },
  [NotificacaoTipoEnum.EscalaSubstituicaoRecusada]: { library: 'MaterialCommunityIcons', name: 'account-cancel', size: 14 },
  [NotificacaoTipoEnum.EscalaVoluntarioConfirmou]: { library: 'MaterialCommunityIcons', name: 'check-circle-outline', size: 14 },
  [NotificacaoTipoEnum.EscalaVoluntarioRecusou]: { library: 'MaterialCommunityIcons', name: 'close-circle-outline', size: 14 },
  [NotificacaoTipoEnum.EscalaSubstituicaoSolicitadaLider]: { library: 'MaterialCommunityIcons', name: 'account-switch-outline', size: 14 },
  [NotificacaoTipoEnum.EscalaSubstituicaoResolvidaLider]: { library: 'MaterialCommunityIcons', name: 'account-check-outline', size: 14 },
  [NotificacaoTipoEnum.MinisterioNovoIntegrante]: { library: 'MaterialCommunityIcons', name: 'account-plus', size: 14 },
  [NotificacaoTipoEnum.IndisponibilidadeConflito]: { library: 'MaterialCommunityIcons', name: 'alert-circle-outline', size: 14 },
  [NotificacaoTipoEnum.IgrejaVinculoAprovado]: { library: 'MaterialCommunityIcons', name: 'church', size: 14 },
  [NotificacaoTipoEnum.IgrejaVinculoNegado]: { library: 'MaterialCommunityIcons', name: 'church', size: 14 },
  [NotificacaoTipoEnum.IgrejaVinculoSolicitado]: { library: 'MaterialCommunityIcons', name: 'account-clock', size: 14 },
  [NotificacaoTipoEnum.IgrejaConviteAceito]: { library: 'MaterialCommunityIcons', name: 'handshake', size: 14 },
  [NotificacaoTipoEnum.IgrejaNovoVoluntario]: { library: 'MaterialCommunityIcons', name: 'account-plus-outline', size: 14 },
  [NotificacaoTipoEnum.IgrejaConviteExpirado]: { library: 'MaterialCommunityIcons', name: 'timer-sand-complete', size: 14 },
};

const DEFAULT_ICON: CustomIconProps = { library: 'MaterialCommunityIcons', name: 'bell-outline', size: 14 };

export default function NotificacaoCard({
  data,
  onPress,
}: {
  data: ResponseNotificacaoDto;
  onPress?: (notification: ResponseNotificacaoDto) => void;
}) {
  const Pallete = usePallete();

  const createdAt = data.criadaEm || data.createdAt;
  const timeLabel = createdAt ? DateUtils.timeAgoText(new Date(createdAt)) : '';

  const title = data.titulo?.trim() ? data.titulo : 'Notificação';

  return (
    <Pressable
      style={({ pressed }) => [styles.pressable, pressed && styles.pressed]}
      onPress={() => onPress?.(data)}
      disabled={!onPress}
      accessibilityRole={onPress ? 'button' : undefined}
    >
      <FancyCardIcon
        cardIcon={data.tipo ? NOTIFICACAO_ICONS[data.tipo] ?? DEFAULT_ICON : DEFAULT_ICON}
        title={
          <FancyText size='small' type='bold' numberOfLines={1} style={{ flex: 1, opacity: 0.8 }}>
            {title}
          </FancyText>
        }
        subtitle={
          data.mensagem ? (
            <FancyText type='medium' size='extraSmall' style={{ lineHeight: 13 }} numberOfLines={2}>
              {data.mensagem}
            </FancyText>
          ) : null
        }
        additionalData2={
          <View style={styles.timeRow}>
            <FancyText
              size='extraSmall'
              type='semiBold'
              numberOfLines={1}
              style={{ opacity: 0.55, color: Pallete.fonts.inactive }}
            >
              {timeLabel}
            </FancyText>
          </View>
        }
        actionButtons={[
          {
            icon: {
              ...DefaultIconsNames['chevron-right'],
              size: 18,
              color: Pallete.fonts.inactive,
              backgroundColor: 'transparent',
            },
            size: 'small',
          },
        ]}
      />
    </Pressable>
  );
}

const styles = StyleSheet.create({
  pressable: {
    borderRadius: 24,
  },
  pressed: {
    opacity: 0.85,
  },
  timeRow: {
    alignItems: 'flex-end',
  },
});
